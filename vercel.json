{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/history",
      "destination": "/timeline/",
      "permanent": true
    },
    {
      "source": "/history/",
      "destination": "/timeline/",
      "permanent": true
    },
    {
      "source": "/hmkg",
      "destination": "/archived-work/",
      "permanent": true
    },
    {
      "source": "/mountain-milk",
      "destination": "/archived-work/",
      "permanent": true
    },
    {
      "source": "/humming-people",
      "destination": "/archived-work/",
      "permanent": true
    },
    {
      "source": "/brathwait",
      "destination": "/archived-work/",
      "permanent": true
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
